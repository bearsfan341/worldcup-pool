{
  "version": 2,
  "routes": [
    { "src": "/api/fetch-scores", "dest": "/api/fetch-scores.js" },
    { "src": "/api/cron-update", "dest": "/api/cron-update.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron-update", "schedule": "0 12 * * *" }
  ]
}
